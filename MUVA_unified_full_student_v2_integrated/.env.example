# Default: browser-only Mock simulator. Set to api when the FastAPI MAVLink Gateway is available.
VITE_DATA_SOURCE=mock

# API mode defaults shown explicitly for deployment configuration.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_TELEMETRY_WS_URL=ws://localhost:8000/ws/telemetry
VITE_MAVLINK_MONITOR_WS_URL=ws://localhost:8000/ws/mavlink/monitor
